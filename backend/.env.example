# Database Configuration (ElephantSQL)
# Get your URL from ElephantSQL dashboard: https://customer.elephantsql.com/
# Format: postgres://username:password@host:5432/database

# Example:
# SPRING_DATASOURCE_URL=jdbc:postgresql://bubble.db.elephantsql.com:5432/yourdb
# SPRING_DATASOURCE_USERNAME=yourusername
# SPRING_DATASOURCE_PASSWORD=yourpassword

SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_HOST.db.elephantsql.com:5432/YOUR_DB
SPRING_DATASOURCE_USERNAME=YOUR_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_PASSWORD

# Keycloak Configuration (for later)
SPRING_OIDC_ISSUER_URI=http://localhost:8081/realms/clubcard
